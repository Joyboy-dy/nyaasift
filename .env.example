# nyaasift — toutes les variables du projet, avec des valeurs d'exemple uniquement.
# Copier en .env.local pour le développement (jamais commité).

# Général
NODE_ENV=development

# Application
APP_URL=http://localhost:3530

# Authentification
BETTER_AUTH_SECRET=change-me-at-least-32-characters

# Site privé
# Seul cet e-mail peut créer le premier compte ; il est super admin (jamais modifiable depuis /admin)
SUPER_ADMIN_EMAIL=toi@exemple.fr
# Fichier SQLite (comptes, sessions, invitations)
DATABASE_PATH=data/nyaasift.sqlite
# Fiche de l'extension sur le Chrome Web Store (vide tant qu'elle n'est pas publiée)
CHROME_EXTENSION_URL=
# En-tête où le proxy met l'IP du visiteur (production)
TRUSTED_IP_HEADER=x-forwarded-for
