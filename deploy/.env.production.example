# nyaasift : production, valeurs d'exemple seulement (ce fichier est commité).
# Copier en deploy/.env.prod sur le serveur, ou coller dans Dokploy, puis remplir.
# Générer le secret : bun -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# --- Application (site privé) -------------------------------------------------
NODE_ENV=production
PORT=3000
# Adresse publique du site, en https, sans / final
APP_URL=https://exemple.fr
BETTER_AUTH_URL=https://exemple.fr
BETTER_AUTH_SECRET=
# Seul cet e-mail peut créer le premier compte ; il est super admin
SUPER_ADMIN_EMAIL=toi@exemple.fr
# Base SQLite : dans le volume monté sur /app/data (à sauvegarder)
DATABASE_PATH=/app/data/nyaasift.sqlite
# En-tête où le proxy (Traefik dans Dokploy) met l'IP du visiteur
TRUSTED_IP_HEADER=x-forwarded-for
# Page de l'extension sur le Chrome Web Store (vide tant qu'elle n'est pas publiée)
CHROME_EXTENSION_URL=

# Seulement pour deploy/compose.yaml (images publiées sur GHCR)
IMAGE_PREFIX=ghcr.io/<propriétaire>/nyaasift
VERSION=latest
