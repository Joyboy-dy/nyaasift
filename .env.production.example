# nyaasift — production : seulement les secrets et les valeurs propres à l'environnement.
# Les valeurs non sensibles et leurs défauts vivent dans deploy/compose.yaml.
# Les vraies valeurs vont dans .env.prod, sur le serveur uniquement (jamais commité).

# Images (ghcr.io/<propriétaire>/<projet>, voir .github/workflows/release.yml)
IMAGE_PREFIX=
VERSION=latest

# Application
APP_URL=https://example.com

# Authentification
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://example.com
